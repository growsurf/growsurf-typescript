{
  "name": "growsurf-typescript",
  "version": "1.4.0",
  "description": "The official TypeScript library for the Growsurf API",
  "author": "Growsurf <>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": "github:growsurf/growsurf-typescript",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "prepublishOnly": "echo 'to publish, run pnpm build && (cd dist; pnpm publish)' && exit 1",
    "format": "./scripts/format",
    "prepare": "if ./scripts/utils/check-is-in-git-install.sh; then ./scripts/build && ./scripts/utils/git-swap.sh; fi",
    "tsn": "ts-node -r tsconfig-paths/register",
    "lint": "./scripts/lint",
    "fix": "./scripts/format"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "iconv-lite": "^0.7.3",
    "jest": "^29.4.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-multi": "https://github.com/stainless-api/tsc-multi/releases/download/v1.1.11/tsc-multi.tgz",
    "tsconfig-paths": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "minimatch": "9.0.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@6": "6.14.0",
      "brace-expansion@2": "2.1.4",
      "diff@4": "4.0.4",
      "flatted": "3.4.4",
      "handlebars": "4.7.9",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "minimatch@9": "9.0.9",
      "picomatch@2": "2.3.2"
    }
  },
  "resolutions": {
    "minimatch": "9.0.9"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  }
}
