diff --git a/dist/cjs.js b/dist/cjs.js
index 7c36cbdd06cc22c92d590be3f87a08a91ca06b40..bb4df769abc025974507089adc769ba699e84d25 100644
--- a/dist/cjs.js
+++ b/dist/cjs.js
@@ -71,6 +71,8 @@ function propertyIsOnObject(object, property) {
 
 // Protects from prototype poisoning and unexpected merging up the prototype chain.
 function propertyIsUnsafe(target, key) {
+	// Skip the legacy prototype setter when merging into a new result.
+	if (key === '__proto__') return true
 	return propertyIsOnObject(target, key) // Properties are safe to merge if they don't exist in the target yet,
 		&& !(Object.hasOwnProperty.call(target, key) // unsafe if they exist up the prototype chain,
 			&& Object.propertyIsEnumerable.call(target, key)) // and also unsafe if they're nonenumerable.
@@ -80,6 +82,7 @@ function mergeObject(target, source, options) {
 	var destination = {};
 	if (options.isMergeableObject(target)) {
 		getKeys(target).forEach(function(key) {
+			if (key === '__proto__') return
 			destination[key] = cloneUnlessOtherwiseSpecified(target[key], options);
 		});
 	}
